{
  "expo": {
    "name": "Dix FM",
    "slug": "dixfm",
    "scheme": "dixfm",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0d0820",
    "ios": {
      "bundleIdentifier": "com.dixfm.app",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "es"
      }
    },
    "android": {
      "package": "com.dixfm.app",
      "adaptiveIcon": {
        "backgroundColor": "#0d0820",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true
        }
      ],
      "expo-font",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0d0820"
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "DixFM",
              "displayName": "Dix FM",
              "description": "La canción que suena y acceso directo a la radio en vivo.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge",
                  "accessoryRectangular"
                ],
                "initialLayout": "./src/widget.ios.tsx"
              }
            }
          ]
        }
      ]
    ]
  }
}
